# .env.ejemplo: plantilla del archivo .env de la plataforma (producción en el hosting cPanel).
# Copiarla como `.env` en la carpeta del proyecto y reemplazar cada <valor>. El archivo `.env` real lleva claves y NO debe compartirse ni mostrarse en capturas.
# Una variable por línea, sin comillas ni espacios alrededor del `=`. Las líneas que empiezan con # son comentarios.

# ---- Base de datos (PostgreSQL del hosting)
BASE_DATOS=postgres
POSTGRES_SERVIDOR=localhost
POSTGRES_PUERTO=5432
POSTGRES_BASE_DATOS=<nombre de la base, con el prefijo de la cuenta>
POSTGRES_USUARIO=<usuario de la base, con el prefijo de la cuenta>
POSTGRES_CONTRASENA=<contraseña del usuario de la base>

# ---- Dirección pública y puertos
PLATAFORMA_URL=https://<dominio de la plataforma>
MT5_API_URL=https://<dominio de la plataforma>
SERVIDOR_ORIGENES=<dominio de la plataforma, sin https://>
SERVIDOR_PUERTO=28000

# ---- Modo de la plataforma
PROVEEDOR=capital
CAPITAL_MULTIUSUARIO=true
# false = solo cuentas demo (recomendado hasta tener la validación legal); true habilita operar en cuenta real
OPERAR_EN_CUENTA_REAL=false

# ---- Claves propias del servidor (se generan una sola vez; ver el paso 6 de la guía de instalación)
# SERVIDOR_SECRETO: texto aleatorio de 32 caracteres o más.
SERVIDOR_SECRETO=<texto aleatorio largo>
# CREDENCIALES_CLAVES: clave Fernet que cifra las claves de Capital.com de cada usuario. Si se pierde o se cambia, esas claves guardadas dejan de poder leerse.
CREDENCIALES_CLAVES=<clave Fernet>

# ---- Inteligencia artificial
DEEPSEEK_API_KEY=<clave de DeepSeek>
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=<clave de Gemini, opcional>

# ---- Capital.com del entorno (solo se usan con CAPITAL_MULTIUSUARIO=false; con true cada usuario conecta la suya)
#CAPITAL_DEMO=true
#CAPITAL_API_KEY=<API key>
#CAPITAL_IDENTIFIER=<correo de la cuenta>
#CAPITAL_API_PASSWORD=<contraseña de la API key>

# ---- Correo (buzón de cPanel, para confirmar cuentas y recuperar contraseñas)
VERIFICACION_CORREO=true
CORREO_SERVIDOR=<servidor de salida, por ejemplo el dominio de la plataforma>
CORREO_PUERTO=465
CORREO_SEGURIDAD=ssl
CORREO_USUARIO=<dirección del buzón, por ejemplo no-responder@dominio>
CORREO_CLAVE=<contraseña del buzón>
CORREO_REMITENTE=<nombre que ve quien recibe el correo>

# ---- reCAPTCHA (claves de Google Cloud, una v3 y una v2)
RECAPTCHA_V3_SITIO=<clave del sitio v3>
RECAPTCHA_V3_SECRETA=<clave secreta v3>
RECAPTCHA_V2_SITIO=<clave del sitio v2>
RECAPTCHA_V2_SECRETA=<clave secreta v2>
