# Ejemplo de .streamlit/secrets.toml para «Continuar con Google» (copiar como secrets.toml y rellenar; ese archivo NO va a git).
# Sin este bloque, o sin la librería Authlib (pip install Authlib), el botón no se muestra y la plataforma funciona como antes.

[auth]
redirect_uri = "https://pyj.rmcabogados.cl/oauth2callback"
cookie_secret = "PEGAR_AQUI_UN_TEXTO_ALEATORIO_LARGO"

[auth.google]
client_id = "PEGAR_AQUI_EL_ID_DE_CLIENTE"
client_secret = "PEGAR_AQUI_EL_SECRETO_DEL_CLIENTE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
